# Copy to .env (gitignored) and fill in — loaded by run.sh before `sia` runs.

# Nebius Token Factory API key — https://docs.tokenfactory.nebius.com
NEBIUS_API_KEY=

# Only needed if you run the meta/feedback agent on Anthropic instead of Nebius:
# ANTHROPIC_API_KEY=

# TokenRouter (OpenAI-compatible gateway) — https://www.tokenrouter.com/docs
# Used by the tokenrouter-claude-meta profile to run the meta/feedback agent on Claude.
# TOKENROUTER_API_KEY=
